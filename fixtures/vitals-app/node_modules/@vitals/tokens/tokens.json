{
  "color": {
    "$type": "color",
    "base": { "teal": { "500": { "$value": "#0e7c86" } }, "red": { "500": { "$value": "#d1242f" } }, "white": { "$value": "#ffffff" }, "gray": { "900": { "$value": "#1f2328" }, "100": { "$value": "#f6f8fa" } } },
    "fg": { "default": { "$value": "{color.base.gray.900}" }, "onEmphasis": { "$value": "{color.base.white}" }, "critical": { "$value": "{color.base.red.500}" } },
    "bg": { "default": { "$value": "{color.base.white}" }, "subtle": { "$value": "{color.base.gray.100}" }, "accent": { "$value": "{color.base.teal.500}" } },
    "border": { "default": { "$value": "#d0d7de" } },
    "brand": { "legacy": { "$value": "#0a5f66", "$deprecated": "Use color.bg.accent" } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" }, "6": { "$value": "24px" }, "8": { "$value": "32px" }
  },
  "radius": { "$type": "dimension", "small": { "$value": "4px" }, "medium": { "$value": "8px" }, "full": { "$value": "9999px" } },
  "font": { "size": { "$type": "dimension", "small": { "$value": "0.875rem" }, "body": { "$value": "1rem" }, "title": { "$value": "1.5rem" } } }
}
